// app/api/flutterwave/verify/route.ts
import { NextRequest, NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

// Server-only client using the service role key — bypasses RLS so this route
// can update any order after confirming payment with Flutterwave directly.
const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

export async function POST(req: NextRequest) {
  try {
    const { transaction_id, order_id } = await req.json();

    if (!transaction_id || !order_id) {
      return NextResponse.json(
        { error: "Missing transaction_id or order_id" },
        { status: 400 }
      );
    }

    // 1. Fetch the order first so we know the expected amount
    const { data: order, error: orderErr } = await supabaseAdmin
      .from("orders")
      .select("*")
      .eq("id", order_id)
      .single();

    if (orderErr || !order) {
      return NextResponse.json({ error: "Order not found" }, { status: 404 });
    }

    // 2. Verify the transaction directly with Flutterwave (never trust the client)
    const verifyRes = await fetch(
      `https://api.flutterwave.com/v3/transactions/${transaction_id}/verify`,
      {
        headers: {
          Authorization: `Bearer ${process.env.FLW_SECRET_KEY}`,
        },
      }
    );
    const verifyData = await verifyRes.json();

    const txn = verifyData?.data;
    const isSuccessful =
      verifyData.status === "success" && txn?.status === "successful";

    if (!isSuccessful) {
      return NextResponse.json(
        { error: "Payment could not be verified" },
        { status: 400 }
      );
    }

    // 3. Confirm the amount charged matches the order amount (prevents underpayment)
    const expectedAmount = Number(order.amount);
    if (expectedAmount && Math.abs(txn.amount - expectedAmount) > 1) {
      return NextResponse.json(
        { error: "Amount mismatch — payment does not match order" },
        { status: 400 }
      );
    }

    // 4. Mark the order paid and move funds into escrow ("holding")
    const { error: updateErr } = await supabaseAdmin
      .from("orders")
      .update({
        status: "paid",
        escrow_status: "holding",
        payment_reference: txn.tx_ref,
        flw_transaction_id: txn.id,
      })
      .eq("id", order_id);

    if (updateErr) throw updateErr;

    // 5. Notify the seller (swap this for email / push notification later)
    // For now the seller sees "Awaiting Delivery Confirmation" in their
    // "My Sales" tab as soon as escrow_status = "holding".

    return NextResponse.json({ success: true });
  } catch (err: any) {
    console.error("Flutterwave verify error:", err);
    return NextResponse.json(
      { error: err.message || "Server error" },
      { status: 500 }
    );
  }
}
